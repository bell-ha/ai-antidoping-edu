# 레포 루트에 .env로 복사해 씁니다(.env는 Git 제외). 비워 두면 괄호 안 기본값.

# AI 답변: mock(키 없이 고정 답) · live(실제 Claude)
LLM_MODE=mock
ANTHROPIC_API_KEY=
# 조직 키(sk-ant-usr-…)면 워크스페이스 ID도 필요. 빠지면 API가 400을 돌려줘 "지금은 답변을 만들 수 없어요"가 나온다
# ANTHROPIC_WORKSPACE_ID=
# CLAUDE_MODEL=claude-sonnet-5-5

# 1(데모, 기본): 로그인 화면에 더미 코드 표시 · 0(시범): 비밀키 검사, 검토 전 항목 등은 알림만
# DEMO_MODE=1
# 시범에서는 32자 이상 무작위로(예: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
# SESSION_SECRET=
# HTTPS로 운영할 때 1
# COOKIE_SECURE=0

# 사용자별 하루 AI 답변 횟수(30)
# DAILY_CHAT_LIMIT=30
# 설문 주소(https://…, {pid} 자리에 선수 번호가 들어감). 비우면 설문 버튼 없음
# SURVEY_URL=

# 연구진 모델 폴더(private/models가 있으면 그것, 없으면 backend/settings의 합성 모델)
# MODEL_DIR=
# 운영 DB 위치(var/app.sqlite)
# APP_DB=
